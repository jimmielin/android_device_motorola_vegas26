# Camera
ro.camera.disableJpegR=true
ro.vendor.camera.aishutter.support=0
ro.vendor.camera.insensorzoom.support=0
vendor.camera.main2vcm.devname=0
vendor.camera.vidhance.IHCon=0

# Haptics
ro.vendor.mot.awinic.tiktap=1

# NFC: stock's nxpnfcinfo picks the vegas26 ("orlando") SN220 RF tuning when
# ro.boot.radio is NA2; set it directly instead of shipping nxpnfcinfo.
persist.vendor.nfc.config_file_name=libnfc-nxp_220e_orlando.conf

# Radio
ro.vendor.radio.imei.sv=22
