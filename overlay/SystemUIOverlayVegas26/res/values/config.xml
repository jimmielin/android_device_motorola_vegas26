<resources>
    <!-- The display supports the DOZE and DOZE_SUSPEND power states, so doze
         pulses do not need to force the display fully on. -->
    <bool name="doze_display_state_supported">true</bool>
    <bool name="doze_suspend_display_state_supported">true</bool>

    <!-- While the front camera (camera ID 1) is in use, draw a protection ring
         around the punch hole: a circle of radius 37 px centered at (540, 67)
         in native (1080 x 2388) pixels, inside the display cutout. -->
    <bool name="config_enableDisplayCutoutProtection">true</bool>
    <string name="config_frontBuiltInDisplayCutoutProtection" translatable="false">M 503,67 a 37,37 0 1 0 74,0 a 37,37 0 1 0 -74,0 Z</string>
    <string name="config_protectedCameraId" translatable="false">1</string>
</resources>
