    <!-- The 1080 x 2388 panel offers 60, 90 and 120 Hz modes. A default refresh
         rate of 0 lets the peak refresh rate act as the default. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- Color modes offered in Settings: natural (0) and saturated (2). -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>2</item>
    </integer-array>

    <!-- Punch-hole front camera at the top center of the panel, described as a
         90 x 112 px box in native (1080 x 2388) pixels. Its height also sets the
         minimum status bar height. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M -45,0 L 45,0 L 45,112 L -45,112 Z</string>

    <!-- Vibration patterns used when the vibrator HAL does not implement the
         matching predefined effect: heavy click, click and tick. -->
    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>75</item>
    </integer-array>
    <integer-array name="config_virtualKeyVibePattern">
        <item>0</item>
        <item>45</item>
    </integer-array>
    <integer-array name="config_clockTickVibePattern">
        <item>0</item>
        <item>15</item>
    </integer-array>

    <!-- The 3.5 mm headset jack reports plug events through the input
         subsystem (switch events) rather than through uevents. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- SIM slot 1 is the embedded eSIM; slot 0 is the removable nano-SIM tray. -->
    <integer-array name="non_removable_euicc_slots">
        <item>1</item>
    </integer-array>

    <!-- MMS user agent and UAProf URL sent to carrier MMSCs. -->
    <string name="config_mms_user_agent" translatable="false">motogpower2025</string>
    <string name="config_mms_user_agent_profile_url" translatable="false">http://uaprof.motorola.com/phoneconfig/motov1/Profile/motov1.rdf</string>
</resources>
