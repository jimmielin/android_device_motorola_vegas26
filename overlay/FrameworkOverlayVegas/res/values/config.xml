<resources>
    <!-- The Goodix sensor in the power key, exposed by the HIDL fingerprint HAL
         as sensor 0 (id:modality:strength = 0:fingerprint:strong). -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>

    <!-- The fingerprint sensor is built into the power button. -->
    <bool name="config_is_powerbutton_fps">true</bool>

    <!-- Side fingerprint sensor location: display, x, y, radius. The power key
         sits on the right edge, 1040 px from the top of the panel. -->
    <array name="config_sfps_sensor_props" translatable="false">
        <item>@array/config_sfps_sensor_props_0</item>
    </array>
    <array name="config_sfps_sensor_props_0" translatable="false">
        <item></item>
        <item>0</item>
        <item>1040</item>
        <item>0</item>
    </array>

    <!-- Brightness: the panel reaches about 500 nits at backlight level 241 and
         up to 1000 nits at full backlight. config_screenBrightnessBacklight
         (framework 0-255 scale) and config_screenBrightnessNits describe the
         panel response; the float values below are fractions of the full
         backlight range. -->

    <!-- Lowest brightness the user can select: the lowest non-zero entry of
         config_screenBrightnessBacklight (7), i.e. (7 - 1) / 254. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0236221</item>

    <!-- Brightness used on first boot: backlight level 111 of 255. -->
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.435294</item>

    <!-- Brightness used to dim the screen before the user activity timeout expires. -->
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.0236221</item>

    <!-- Brightness used while dozing: backlight level 17 on the 0-255 scale,
         i.e. (17 - 1) / 254. Stock sets this only as the integer
         config_screenBrightnessDoze in its framework-res product overlay. -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.06299213</item>

    <!-- Ambient light (lux) thresholds for the auto-brightness curve. Each entry
         starts a new control point in config_autoBrightnessDisplayValuesNits. -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>2</item>
        <item>5</item>
        <item>10</item>
        <item>29</item>
        <item>50</item>
        <item>90</item>
        <item>100</item>
        <item>150</item>
        <item>200</item>
        <item>300</item>
        <item>400</item>
        <item>500</item>
        <item>800</item>
        <item>1000</item>
        <item>1300</item>
        <item>1500</item>
        <item>1600</item>
        <item>1800</item>
        <item>2000</item>
        <item>3000</item>
        <item>4000</item>
        <item>10000</item>
        <item>20000</item>
        <item>30000</item>
    </integer-array>

    <!-- Target screen brightness in nits for each auto-brightness control point;
         one entry longer than config_autoBrightnessLevels. -->
    <array name="config_autoBrightnessDisplayValuesNits">
        <item>3</item>
        <item>10</item>
        <item>20</item>
        <item>50</item>
        <item>70</item>
        <item>85</item>
        <item>110</item>
